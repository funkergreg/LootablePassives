# Runtime artifacts the mod writes at play time. Game output, not source.
#
# The recovery journal is written to the UE4SS root, outside the directories
# the official mod loader reinstalls this mod into. Listed here in case anyone
# runs the game from a checkout.
LootablePassives_journal.tsv
# Same for the conveyor pending-grant ledger, which tools/ledger_test.lua also
# writes and removes beside Scripts/ when it runs from a checkout.
LootablePassives_pending.tsv

# tools/luacheck.js needs luaparse, which package.json declares. `npm install`
# in the repo root fetches it; never vendored.
node_modules/
package-lock.json

# Local Claude Code config: absolute machine paths, not part of the mod.
.claude/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
*.bak
*.bak-*

# Palworld Mod Uploader's file. It lives in the Workshop item folder, holds the
# Published ID and last uploaded Version, and is never copied into the repo.
.workshop.json

# Screenshots used in dev and testing
.docs/*.png
.docs/**/*.png